{
  "name": "hatch-cli",
  "version": "0.1.0",
  "description": "Bootstrap production-ready SaaS applications from user stories",
  "main": "dist/index.js",
  "bin": {
    "hatch": "./dist/index.js"
  },
  "scripts": {
    "dev": "nodemon --watch src --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cli",
    "saas",
    "bootstrap",
    "generator",
    "nx",
    "react",
    "nextjs",
    "nestjs",
    "typescript"
  ],
  "author": "Your Name",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "cosmiconfig": "^9.0.1",
    "ejs": "^4.0.1",
    "execa": "^9.6.1",
    "fs-extra": "^11.3.4",
    "inquirer": "^13.3.0",
    "ora": "^9.3.0",
    "zod": "^4.3.6"
  }
}
