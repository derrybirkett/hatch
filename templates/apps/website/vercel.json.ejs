{
  "version": 2,
  "name": "<%= projectName %>-website",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "env": {
    "NEXT_PUBLIC_API_URL": "@api-url",
    "NEXT_PUBLIC_DASHBOARD_URL": "@dashboard-url"
  },
  "buildCommand": "npx nx build website --prod",
  "installCommand": "npm ci",
  "framework": "nextjs",
  "outputDirectory": "dist/apps/website/.next"
}
