## Usage

```typescript
import { apiClient } from '@<%= projectName %>/<%= libraryName %>';
import type { User, ApiResponse } from '@<%= projectName %>/<%= libraryName %>';

// Make API calls
const response = await apiClient.get<User>('/users/me');

